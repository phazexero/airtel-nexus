# Leave blank to run the demo on the built-in rules engine (default).
# Set these later to route Next Best Action + Campaign Studio through a real model.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Set to false to force the schematic map instead of live tiles. Worth doing if
# you are presenting somewhere the wifi cannot be trusted; the app falls back on
# its own if tiles fail, but this skips the attempt entirely.
NEXT_PUBLIC_LIVE_MAP=
